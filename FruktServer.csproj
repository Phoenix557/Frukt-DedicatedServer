<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FruktServer</AssemblyName>
    <RootNamespace>FruktServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.4.0</Version>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="docker\**;dist\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <TrimmerRootAssembly Include="BepuPhysics" />
    <TrimmerRootAssembly Include="BepuUtilities" />
  </ItemGroup>

  <!-- Protocol.cs and Shapes.cs belong to the Multiplayer mod; these copies keep the repo buildable on its own (GitHub Actions). -->
  <Target Name="SyncProtocol" BeforeTargets="BeforeBuild" Condition="Exists('..\Frukt-Multiplayer\Protocol.cs')">
    <Copy SourceFiles="..\Frukt-Multiplayer\Protocol.cs;..\Frukt-Multiplayer\Shapes.cs" DestinationFolder="$(MSBuildProjectDirectory)" SkipUnchangedFiles="true" />
  </Target>
</Project>
